# Ignore Terraform state and crash logs
*.tfstate
*.tfstate.*
crash.log

# Ignore .terraform directories (local plugin/cache data)
.terraform/

# Ignore plan output
*.tfplan

# Ignore sensitive files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE/editor settings (optional, but recommended)
.vscode/
.idea/
*.swp
*.bak
*.tmp

# MacOS/Windows system files (optional)
.DS_Store
Thumbs.db
